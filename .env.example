# Kopyala: .env  (ASLA repoya/sohbete yazma)
# --- Instagram (Instagram API with Instagram Login) ---
META_APP_ID=
META_APP_SECRET=
# uzun ömürlü Instagram token (~60 gün; sistem 30 günde bir kendisi yeniler)
IG_ACCESS_TOKEN=
# markanın Instagram hesabı ID'si
IG_BUSINESS_USER_ID=
# sadece bu gönderenden gelen DM'ler işlenir
OWNER_IGSID=
# ek doğrulama
OWNER_USERNAME=
# IG_API_VERSION=v25.0
# --- Anthropic API (senaryo/storyboard/araştırma/fotoğraf seçimi) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 -> reel kareleri de konu çıkarma çağrısına gider (varsayılan: yalnızca konuşma metni; sessiz reel'de otomatik kareler)
# SEND_FRAMES=0
# --- Google Görseller (serper.dev, kayıtta 2500 ücretsiz sorgu): fotoğraf aramasını Wikimedia yerine Google yapar ---
SERPER_API_KEY=
# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# --- YouTube (python batch/auto/auth_youtube.py çalıştırınca REFRESH_TOKEN yazılır) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# --- Bildirim: Discord kanalı > Ayarlar > Entegrasyonlar > Webhooklar > Yeni Webhook > URL'yi kopyala ---
DISCORD_WEBHOOK_URL=
# --- Davranış ---
# 1 -> video hazır olunca yayınlanmaz; DM ile 'onay 16.45' / 'onay şimdi' / 'iptal' beklenir
APPROVAL_REQUIRED=1
# Reels kapak karesi (ms): 1000 = videonun 1. saniyesi
# IG_COVER_OFFSET_MS=1000
PLATFORMS=instagram,youtube
# yerel saat
PUBLISH_SLOTS=12:30,20:00
# 0 = sınırsız; bir sayı yazarsan günlük üretim üst sınırı olur
MAX_JOBS_PER_DAY=0
# hazır/başarısız bildirimleri DM ile
DM_NOTIFY=1
# YT_PRIVACY=public
# CLAUDE_MODEL=
# --- Yerel araclar ---
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL=models/ggml-large-v3.bin
